# Copy to .env (or set these in your shell). Never commit real keys.

PORT=8080

# Clients must send: Authorization: Bearer <one of these>
GATEWAY_KEYS=change-me-local-key

RATE_LIMIT_PER_MIN=30
REQUEST_TIMEOUT_MS=120000
BREAKER_THRESHOLD=3
BREAKER_COOLDOWN_MS=30000

# Backend 1: local Ollama (free, runs on this PC). Set OLLAMA_URL=off to disable.
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:1b

# Backend 2 (optional): another self-hosted open-source server with an OpenAI-compatible API,
# for example llama.cpp server (default port 8080) or LM Studio (default port 1234).
# LOCAL_OPENAI_URL=http://localhost:8081/v1
# LOCAL_OPENAI_MODEL=default
# LOCAL_OPENAI_KEY=
